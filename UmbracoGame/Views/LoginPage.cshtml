@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.LoginPage>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using UmbracoGame.Models
@using UmbracoGame.Controllers

@{
    Layout = "_Layout.cshtml";
}

<div style="max-width: 400px; margin: 40px auto; padding: 30px; background: #e9ecef; border-radius: 8px;">
    <h2 style="text-align: center; margin-top: 0;">Member Login</h2>

    @if (TempData["LoginError"] != null)
    {
        <div style="background: #ffcccc; color: #cc0000; padding: 10px; border-radius: 4px; margin-bottom: 15px;">
            @TempData["LoginError"]
        </div>
    }

    @using (Html.BeginUmbracoForm<MemberAuthController>(nameof(MemberAuthController.HandleLogin)))
    {
        <div style="margin-bottom: 15px;">
            <label style="font-weight: bold;">Email Address</label><br />
            <input type="email" name="Username" required style="width: 100%; padding: 10px; box-sizing: border-box;" />
        </div>

        <div style="margin-bottom: 20px;">
            <label style="font-weight: bold;">Password</label><br />
            <input type="password" name="Password" required style="width: 100%; padding: 10px; box-sizing: border-box;" />
        </div>

        <button type="submit" style="width: 100%; padding: 12px; background: #0056b3; color: white; border: none; border-radius: 4px; font-size: 16px; cursor: pointer;">
            Log In
        </button>
    }
</div>