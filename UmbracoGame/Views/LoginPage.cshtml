@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using UmbracoGame.Models
@using UmbracoGame.Controllers
@{
    Layout = "Master.cshtml";
    ViewData["Title"] = "Member Login";
    
    // Create an empty instance of your custom model to attach to the form
    var loginModel = new LoginViewModel();
}

<div style="max-width: 400px; margin: 4rem auto; background: #161b22; padding: 2.5rem; border-radius: 8px; box-shadow: 0 8px 16px rgba(0,0,0,0.6); border: 1px solid #30363d;">
    <h1 style="color: #58a6ff; text-align: center; margin-bottom: 2rem; font-size: 1.8rem; text-transform: uppercase; letter-spacing: 1px;">Arena Access</h1>

    @using (Html.BeginUmbracoForm<MemberAuthController>(nameof(MemberAuthController.HandleLogin), null, new { @class = "login-form" }))
    {

        <div style="margin-bottom: 1.5rem;">
            @Html.LabelFor(m => loginModel.Username, new { @style = "display: block; margin-bottom: 0.5rem; color: #8b949e; font-weight: bold; font-size: 0.9rem;" })
            @Html.TextBoxFor(m => loginModel.Username, new { @style = "width: 100%; padding: 0.8rem; background: #0d1117; border: 1px solid #30363d; color: #c9d1d9; border-radius: 4px; box-sizing: border-box;", placeholder = "Enter your username..." })
            @Html.ValidationMessageFor(m => loginModel.Username, "", new { @style = "color: #ff7b72; font-size: 0.8rem; display: block; margin-top: 0.5rem;" })
        </div>

        <div style="margin-bottom: 2rem;">
            @Html.LabelFor(m => loginModel.Password, new { @style = "display: block; margin-bottom: 0.5rem; color: #8b949e; font-weight: bold; font-size: 0.9rem;" })
            @Html.PasswordFor(m => loginModel.Password, new { @style = "width: 100%; padding: 0.8rem; background: #0d1117; border: 1px solid #30363d; color: #c9d1d9; border-radius: 4px; box-sizing: border-box;", placeholder = "Enter your password..." })
            @Html.ValidationMessageFor(m => loginModel.Password, "", new { @style = "color: #ff7b72; font-size: 0.8rem; display: block; margin-top: 0.5rem;" })
        </div>

        @Html.ValidationSummary(true, "", new { @style = "color: #ff7b72; margin-bottom: 1.5rem; font-size: 0.9rem; text-align: center; font-weight: bold;" })

        <button type="submit" style="width: 100%; padding: 1rem; background-color: #238636; color: white; border: none; border-radius: 4px; font-weight: bold; font-size: 1rem; cursor: pointer; text-transform: uppercase; letter-spacing: 1px; transition: background 0.2s;">Secure Login</button>
    }
</div>