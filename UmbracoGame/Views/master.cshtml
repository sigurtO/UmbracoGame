@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
	Layout = null;
    var isLoggedIn = Context.User?.Identity?.IsAuthenticated ?? false;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Arena Portal</title>
    
    <style>
        body { background-color: #0d1117; color: #c9d1d9; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; padding: 0; }
        
        /* The Navigation Header */
        header { background-color: #161b22; padding: 1rem 2rem; border-bottom: 2px solid #30363d; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 6px rgba(0,0,0,0.3); }
        .logo { color: #ff5555; font-size: 1.5rem; font-weight: bold; text-decoration: none; text-transform: uppercase; letter-spacing: 2px; }
        
        nav { display: flex; gap: 1.5rem; align-items: center; }
        nav a { color: #58a6ff; text-decoration: none; font-weight: bold; font-size: 1.1rem; transition: color 0.2s; }
        nav a:hover { color: #ff7b72; }
        
        .login-btn { border: 1px solid #58a6ff; padding: 0.4rem 1rem; border-radius: 4px; }
        .login-btn:hover { background-color: #58a6ff; color: #0d1117; }

        /* The Main Content Area */
        main.container { padding: 2rem; max-width: 1200px; margin: 0 auto; }
    </style>
</head>
<body>

    <header>
        <a href="/" class="logo">Arena Portal</a>
        <nav>
            <a href="/">Play Game</a>
            <a href="/global-leaderboards">Leaderboard</a>
            
            @if (isLoggedIn)
            {
                <a href="/umbraco/surface/memberauth/handlelogout" class="login-btn" style="border-color: #ff7b72; color: #ff7b72;">Logout</a>
            }
            else
            {
                <a href="/login" class="login-btn">Login</a>
            }        </nav>
    </header>

    <main class="container">
        @RenderBody()
    </main>

</body>
</html>